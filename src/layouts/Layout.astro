---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Portfolio',
	description = 'A collection of projects and case studies.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#0b0b0b" />
		<title>{title}</title>
	</head>
	<body>
		<slot />
		<footer class="site-footer">
			<div class="wrap">
				<span class="micro">R. Molyneux / Portfolio</span>
				<span class="micro">Software engineer — audio</span>
				<span class="micro">MMXXVI</span>
			</div>
		</footer>
	</body>
</html>
