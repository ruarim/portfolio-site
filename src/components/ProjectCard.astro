---
import type { CollectionEntry } from 'astro:content';
import GitHubLink from './GitHubLink.astro';
import { withBase } from '../lib/paths';

interface Props {
	project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
---

<article class:list={['project', { featured: project.data.featured }]}>
	<div class="title-row">
		<h2>
			<a href={withBase(`/projects/${project.id}/`)}>{project.data.title}</a>
		</h2>
		{project.data.githubUrl && (
			<GitHubLink href={project.data.githubUrl} label={project.data.title} />
		)}
	</div>
	<p>{project.data.description}</p>
	<p class="meta">
		<time datetime={project.data.date.toISOString()}>
			{project.data.date.toLocaleDateString('en', {
				year: 'numeric',
				month: 'long',
				day: 'numeric',
			})}
		</time>
	</p>
	<ul class="tags">
		{project.data.tags.map((tag) => (
			<li>{tag}</li>
		))}
	</ul>
</article>
