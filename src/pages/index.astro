---
import { getCollection } from 'astro:content';
import ModularWordmark from '../components/ModularWordmark.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Layout from '../layouts/Layout.astro';

const projects = (await getCollection('projects')).sort((a, b) => {
	if (a.data.featured !== b.data.featured) {
		return a.data.featured ? -1 : 1;
	}

	return b.data.date.getTime() - a.data.date.getTime();
});

const professionalProjects = projects.filter(
	(project) => project.data.category === 'professional',
);
const personalProjects = projects.filter((project) => project.data.category === 'personal');
---

<Layout
	title="Ruari Molyneux — Portfolio"
	description="Selected projects and case studies by Ruari Molyneux, a software engineer specialising in audio applications."
>
	<main>
		<header class="hero">
			<div class="hero-inner">
				<h1 class="hero-title">
					<span class="sr-only">Ruari Molyneux</span>
					<ModularWordmark text={'ruari\nmolyneux'} class="hero-wordmark" />
				</h1>
				<p class="hero-lede">
					A software engineer specialising in audio applications. I build tools in close
					collaboration with the people who use them, from journalists to hard-of-hearing users.
					Here you will find a selection of my work.
				</p>
			</div>
		</header>

		<section class="work" aria-labelledby="work-heading">
			<div class="wrap">
				<div class="work-head">
					<div class="section-brand">
						<p class="micro work-label">01 / Selected work</p>
						<h2 class="section-title" id="work-heading">
							<span class="sr-only">Selected work</span>
							<ModularWordmark text="work" class="section-wordmark" />
						</h2>
					</div>
					<div class="tabs" role="tablist" aria-label="Project categories">
						<button
							class="tab"
							id="tab-professional"
							role="tab"
							aria-selected="true"
							aria-controls="panel-professional"
							tabindex="0"
						>
							<span class="tab-index" aria-hidden="true">01</span> Professional
						</button>
						<button
							class="tab"
							id="tab-personal"
							role="tab"
							aria-selected="false"
							aria-controls="panel-personal"
							tabindex="-1"
						>
							<span class="tab-index" aria-hidden="true">02</span> Personal
						</button>
					</div>
				</div>
				<div
					class="tab-panel"
					id="panel-professional"
					role="tabpanel"
					aria-labelledby="tab-professional"
					tabindex="0"
				>
					{professionalProjects.map((project, index) => (
						<ProjectCard project={project} index={index + 1} />
					))}
				</div>
				<div
					class="tab-panel"
					id="panel-personal"
					role="tabpanel"
					aria-labelledby="tab-personal"
					tabindex="0"
					hidden
				>
					{personalProjects.map((project, index) => (
						<ProjectCard project={project} index={index + 1} />
					))}
				</div>
				<noscript>
					<style>
						[role='tablist'] {
							display: none;
						}

						[role='tabpanel'][hidden] {
							display: block;
						}
					</style>
				</noscript>
			</div>
		</section>
	</main>
</Layout>

<script>
	const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[role="tab"]'));

	function activate(tab: HTMLButtonElement, focus = false) {
		for (const current of tabs) {
			const selected = current === tab;
			const panel = document.getElementById(current.getAttribute('aria-controls') ?? '');

			current.setAttribute('aria-selected', String(selected));
			current.tabIndex = selected ? 0 : -1;

			if (panel) {
				panel.hidden = !selected;
			}
		}

		if (focus) {
			tab.focus();
		}
	}

	tabs.forEach((tab, index) => {
		tab.addEventListener('click', () => activate(tab));
		tab.addEventListener('keydown', (event) => {
			let nextIndex: number | null = null;

			if (event.key === 'ArrowRight') {
				nextIndex = (index + 1) % tabs.length;
			} else if (event.key === 'ArrowLeft') {
				nextIndex = (index - 1 + tabs.length) % tabs.length;
			} else if (event.key === 'Home') {
				nextIndex = 0;
			} else if (event.key === 'End') {
				nextIndex = tabs.length - 1;
			}

			if (nextIndex !== null) {
				event.preventDefault();
				activate(tabs[nextIndex], true);
			}
		});
	});
</script>
